{
  "name": "cpp-lectures",
  "private": true,
  "version": "1.0.0",
  "description": "Slidev source for the Modern C++ Programming lecture series.",
  "scripts": {
    "dev": "slidev 0-intro/slides.md --open",
    "build": "slidev build 0-intro/slides.md --out dist",
    "export:pdf": "slidev export 0-intro/slides.md --output 0-intro/0-intro.pdf",
    "export:pptx": "slidev export 0-intro/slides.md --format pptx --output 0-intro/0-intro.pptx",
    "export": "npm run export:pdf && npm run export:pptx"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/noto-sans-sc": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@slidev/cli": "^52.8.0",
    "@slidev/theme-default": "latest",
    "playwright-chromium": "^1.55.1",
    "vite": "^7.1.7",
    "vue": "^3.5.21"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/radio-canada-big": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0"
  }
}
